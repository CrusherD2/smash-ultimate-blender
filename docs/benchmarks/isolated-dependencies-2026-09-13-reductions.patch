# Experimental reductions to the isolated clone's dependency graph, measured by
# tests/benchmark_isolated_dependencies_blender.py. Empty by default: each one
# must be shown both exact and faster before it becomes a default.
def _reductions():
    return frozenset(f for f in os.environ.get('SUB_IK_REDUCE', '').split(',') if f)


def _prune_action(clone, needed):
    """Give the clone its own action with only the retained bones' channels.

    obj.copy() shares the action datablock, so the copy must happen before any
    curve is touched -- editing the user's own action would be data loss. The
    returned action is removed by the caller's cleanup.
    """
    anim = clone.animation_data
    if not anim or not anim.action:
        return None
    identifier = getattr(getattr(anim, 'action_slot', None), 'identifier', None)
    action = anim.action.copy()
    anim.action = action
    if identifier is not None:
        for slot in getattr(action, 'slots', ()):
            if slot.identifier == identifier:
                anim.action_slot = slot
                break
    keep = tuple(clone.pose.bones[n].path_from_id() + '.' for n in needed
                 if n in clone.pose.bones)
    from ..anim.fcurve_compat import get_all_action_fcurves, remove_fcurve
    for fc in list(get_all_action_fcurves(action, id_type='OBJECT')):
        if fc.data_path.startswith('pose.bones[') and not fc.data_path.startswith(keep):
            remove_fcurve(action, fc, id_type='OBJECT')
    return action


def _collapse_bbones(data, needed):
    """Drop B-Bone subdivision on retained bones.

    Segment evaluation runs on every graph update. It should not be able to
    move pb.matrix, which is the only thing the search reads -- but that is a
    claim for the exactness gate to confirm, not an assumption to build on.
    """
    for bone in data.bones:
        if bone.name in needed and bone.bbone_segments > 1:
            bone.bbone_segments = 1


def _pin_ancestors(context, scene, view, clone, data, needed, direct, sampled):
    """Unparent retained bones that exist only to carry an ancestor pose.

    A bone may be unparented only when its own world matrix is in the sampled
    set, because the caller re-places it from that sample on every frame. Bones
    without a sample keep their parent, and therefore keep their ancestors.

    Parents that are themselves solve-relevant (``direct``) are left alone: the
    win is cutting the link to ancestors that exist *only* as ancestors, and
    those bones' poses move during the solve, so they must not be pinned away.

    Rest data is untouched -- ``matrix_local`` is armature space and does not
    depend on the parent -- and the caller's existing rest verification
    re-checks that claim rather than trusting it.
    """
    candidates = []
    for name in sorted(needed):
        if name not in sampled:
            continue
        pose_bone = clone.pose.bones.get(name)
        if pose_bone is None or pose_bone.parent is None:
            continue
        if pose_bone.parent.name in direct:
            continue
        # The caller places pinned bones with pose_math.apply_world, which
        # declines bones outside the modeled inheritance case and would then
        # leave them silently at rest.
        if not pose_math.supports(pose_bone):
            continue
        candidates.append(name)
    if not candidates:
        return []
    pinned = []
    with context.temp_override(scene=scene, view_layer=view,
                               object=clone, active_object=clone):
        bpy.ops.object.mode_set(mode='EDIT')
        for name in candidates:
            bone = data.edit_bones.get(name)
            if bone is None or bone.parent is None:
                continue
            # Clear the connection first so Blender cannot shift the head.
            bone.use_connect = False
            bone.parent = None
            pinned.append(name)
        bpy.ops.object.mode_set(mode='OBJECT')
    return pinned

