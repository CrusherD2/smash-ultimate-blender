# 4) source/extras/ik_channels.py -- extension appended to `_sample_names()`,
#    just before its final `return names` (which was `return
#    list(dict.fromkeys(names))` before this extension existed, and is again
#    after Task 6)
# ============================================================================

    names = list(dict.fromkeys(names))
    # Also sample each of those bones' parents. Purely additive: an extra
    # sampled bone costs sampling time and changes no output, and the
    # isolated clone's `pin` reduction can only unparent a bone whose own
    # world matrix is available to re-place it from.
    for name in list(names):
        pose_bone = obj.pose.bones.get(name)
        parent = pose_bone.parent if pose_bone is not None else None
        if parent is not None and parent.name not in names:
            names.append(parent.name)
    return names

