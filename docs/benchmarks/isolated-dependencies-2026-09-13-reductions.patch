# ============================================================================

            # Reductions run before the driver prune so that a set `needed`
            # shrunk by `pin` still drops the drivers of the bones it orphaned.
            # With SUB_IK_REDUCE unset `needed` is untouched here and the prune
            # sees exactly what it saw before.
            reductions = _reductions()
            if 'pin' in reductions:
                sampled = set(ik._sample_names(obj, jobs, ik._chain_cache(obj, jobs)))
                pinned = _pin_ancestors(context, scene, view, clone, data,
                                        needed, direct, sampled)
                if pinned:
                    # Recompute from scratch so the now-orphaned ancestors drop
                    # out before the edit-bone prune runs.
                    needed = _closure(clone, obj, direct, pinned)
                diag.note('pin', 'pinned_%d_kept_%d_of_%d'
                          % (len(pinned), len(needed), len(obj.data.bones)))
            if 'action' in reductions:
                action = _prune_action(clone, needed)
            if 'bbone' in reductions:
                _collapse_bbones(data, needed)

# ...and in the `finally:` cleanup block, after the scene/armature/object
# removal:

        if action is not None:
            bpy.data.actions.remove(action)

